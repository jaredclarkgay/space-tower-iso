# Godot 4+ specific ignores
.godot/
/android/

# Python bytecode (agent/analysis/ tooling)
__pycache__/
*.pyc

# Telemetry session stream — dev runs write here (read by agent/analysis/
# session_summary.py). Play data, never committed.
/_telemetry/

# OS noise
.DS_Store
*.tmp

# Export artifacts (not committed; generated via export presets)
export.cfg

# Claude Code config — share project-level settings, agents, and slash
# commands across machines; keep transient session scratch local.
.claude/*
!.claude/settings.json
!.claude/agents/
!.claude/commands/

# Stray screenshots dropped at the repo root. Phase 5 intentional captures
# still go in prototype_screenshots/.
/Screenshot*.png
/Screenshot*.png.import

# Local dev rig for capturing animation frames via --write-movie. Re-create
# from `tools/anim_capture.gd` if needed; not part of the shipping game.
/tools/

# Throwaway windowed-screenshot rigs (used to verify gameplay remotely) + their
# output. Re-create from the template in agent/rules/godot_screenshot_harness.md
# anytime; not part of the game.
/_*_harness.*
/_shots/

# graphify code-graph output. Regenerable for free with `graphify update .`
# (no API cost) and goes stale as code changes. Keep the human-readable
# report; ignore the bulky/churny graph data, interactive HTML, and cache.
/graphify-out/*
!/graphify-out/GRAPH_REPORT.md
