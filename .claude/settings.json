{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "out=$(python3 \"$CLAUDE_PROJECT_DIR/agent/analysis/session_summary.py\" --agent 2>/dev/null); jq -n --arg o \"$out\" '{systemMessage:$o, hookSpecificOutput:{hookEventName:\"SessionStart\", additionalContext:$o}, suppressOutput:true}'",
            "timeout": 10,
            "statusMessage": "Reading Builder Agent advancement…"
          }
        ]
      }
    ]
  }
}
